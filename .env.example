# Copy to .env (git-ignored) and fill in. Values are read by ${VAR} in qsl-send.yaml.

# Gmail: your full address, and a 16-character App Password (NOT your Google
# password) from https://myaccount.google.com/apppasswords — requires 2-Step
# Verification to be on. Paste it without the spaces Google shows.
SMTP_USERNAME=myemail@gmail.com
SMTP_PASSWORD=my-app-password

# QRZ.com XML subscription, only needed when qrz.enabled is true.
QRZ_USERNAME=
QRZ_PASSWORD=
